# ArchMuse -- variables de entorno
#
# Copia este archivo a `.env` y rellena lo que necesites:
#     PowerShell:  Copy-Item .env.example .env
#     bash/zsh:    cp .env.example .env
#
# `.env` lo leen `app.py`, `main.py` y la suite de tests (via `conftest.py`),
# todos a traves de `analyzer/entorno.py`. Requiere `python-dotenv`, que ya
# esta en requirements.txt.
#
# Lo que YA este exportado en tu shell gana siempre sobre lo que ponga aqui
# (`override=False`): un `.env` olvidado no puede pisar los secretos reales de
# un despliegue.
#
# `.env` esta en `.gitignore`; `.env.example` esta explicitamente exceptuado.
# Nunca escribas aqui una clave real: este archivo SI se versiona.


# --- 1. El producto (`app.py` + la SPA de `static/`) ------------------------

# Clave de la API de Anthropic. Sin ella, todo lo que pasa por Claude queda
# desactivado con un aviso explicito -- nunca inventa una respuesta: el
# diagnostico experto, el generador de plantas, el interprete de entrevista, el
# extractor de pliegos y la propuesta de estilos.
#   analyzer/ai_analyst.py, analyzer/ai_generator.py, analyzer/estilos.py,
#   analyzer/interview/claude_interprete.py, analyzer/pliego_extractor.py,
#   extraccion/interprete.py
ANTHROPIC_API_KEY=

# Token publico de Mapbox (`pk....`). El backend se lo sirve al frontend por
# `/api/mapbox-token`. Sin el no hay selector de parcela, ni terreno, ni imagen
# estatica de mapa en el dossier PDF.
#   app.py
MAPBOX_TOKEN=


# --- 2. Arranque (opcionales: las tres tienen valor por defecto) ------------

# Puerto del servidor. Por defecto 5000.
#   app.py
PORT=5000

# FLASK_DEBUG=1 arranca el servidor de desarrollo de Flask, con autorecarga y
# el depurador de Werkzeug -- que ejecuta Python arbitrario desde el navegador.
# Dejalo vacio salvo que estes desarrollando en local: sin el, la app se sirve
# con `waitress` sobre 127.0.0.1.
#   app.py
FLASK_DEBUG=

# Donde viven la base SQLite y los archivos de proyecto. Por defecto
# `~/.archmuse`.
#   analyzer/storage.py
ARCHMUSE_DATA_DIR=


# --- 3. Tests (ninguna hace falta para usar la app; ver README) -------------
#
# `conftest.py` tambien carga este archivo, asi que lo que pongas aqui afecta a
# `pytest` -- y a los 72 scripts de `tests/` que se lanzan en subprocesos, que
# heredan el entorno. Las dos ultimas cambian lo que la suite HACE: leelas.

# Ruta completa a `v2s.dxf`, un plano real de cliente que no esta -- ni puede
# estar -- en el repositorio. Habilita los tests del cuadro de superficies
# (unos 4 min de cobertura extra). Sin ella esos tests se saltan con motivo,
# no fallan.
ARCHMUSE_DXF_V2S=

# Segundos que se le conceden a cada script de `tests/` antes de darlo por
# colgado. Por defecto 900.
#   tests/test_scripts_legacy.py
ARCHMUSE_TEST_TIMEOUT=900

# CUIDADO: =1 hace que los tests del extractor normativo llamen de verdad a la
# API de Anthropic. Consume tokens en cada ejecucion de la suite. Por defecto
# se saltan.
#   tests/test_extraccion_interprete.py
ARCHMUSE_TEST_IA=

# CUIDADO: =1 hace que la suite golpee servicios externos en vivo (boe.es, el
# Catastro) en lugar de los fixtures grabados. Por defecto se saltan, para que
# el resultado no dependa de que esos servicios esten arriba.
#   tests/test_ingesta_boe.py, tests/test_sitio.py
ARCHMUSE_TEST_RED=


# --- 4. JarvisApp.py -- asistente aparte, NO forma parte de ArchMuse --------
#
# Solo las lee `JarvisApp.py` (ver requirements-jarvis.txt e
# "Iniciar Jarvis.bat"), que ademas NO carga este archivo: exportalas a mano.
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash
